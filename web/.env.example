# Heimdall web app (SvelteKit SPA, adapter-static).
#
# PUBLIC_API_URL is read with `$env/static/public`, so it is baked in at build time
# (`pnpm build`) and re-read on every `pnpm dev` start. It is NOT a runtime setting:
# change it, then rebuild. Default when unset: http://127.0.0.1:8080
PUBLIC_API_URL=http://127.0.0.1:8080
