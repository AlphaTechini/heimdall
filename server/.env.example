# heimdalld configuration. Copy to .env (git-ignored) or export the variables.
# Never commit real secrets. Docs: docs/api.md section 3.

# --- HTTP ---
HTTP_ADDR=:8080
# Comma-separated origins allowed by CORS and the WebSocket
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- Postgres (required) ---
DATABASE_URL=postgres://heimdall:heimdall@127.0.0.1:5432/heimdall?sslmode=disable

# --- Chain (required: HTTP) ---
RPC_HTTP_URL=http://127.0.0.1:8545
# Optional. When set, new blocks arrive over a WebSocket subscription; when empty the server polls every 250 ms.
RPC_WS_URL=
# Optional first block to scan for Guard creation logs (default: 0 on a local chain, the current block otherwise).
START_BLOCK=

# --- Config files (paths relative to the working directory, i.e. server/) ---
TARGETS_FILE=../config/targets.local.json
SIGNALS_FILE=../config/signals.json
# Folder of backtest result files (default: a "backtests" folder next to TARGETS_FILE)
BACKTESTS_DIR=

# --- Contracts ---
# Either the factory address...
FACTORY_ADDRESS=
# ...or a deployment file written by the deploy script (default: ../contracts/deployments/<chainId>.json)
DEPLOYMENT_FILE=../contracts/deployments/31337.json

# --- Keeper (required) ---
# Private key (hex) of the keeper account set on the factory. It only pays gas for exits and can only
# trigger exits to each owner. Never log it, never commit it. For local anvil use scripts/local-dev.sh output.
KEEPER_PRIVATE_KEY=

# --- Demo ---
# true enables the incident simulator, and only on a local anvil (chain id 31337).
DEMO_MODE=false

# --- Sign-in ---
# Secret used to sign bearer tokens (32+ random characters). If empty a random one is used and sign-ins end on restart.
AUTH_SECRET=

# --- Alerts (each channel is off when its variables are empty) ---
# Telegram: create a bot with @BotFather. The username is needed for the link button.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Email through Resend: an API key and a sender on a verified domain (or the Resend test sender).
RESEND_API_KEY=
EMAIL_FROM=

# --- Executor ---
# Default cap for the priority tip, in USD (0 < x <= 50)
DEFAULT_TIP_CAP_USD=2

# --- Logging ---
# info (default) or debug
LOG_LEVEL=info

# --- Testing only ---
# Point the Telegram client at a local stub instead of api.telegram.org
# TELEGRAM_API_BASE=http://127.0.0.1:9999
# The Resend Go SDK reads RESEND_BASE_URL (default https://api.resend.com/)
# RESEND_BASE_URL=http://127.0.0.1:9999/
